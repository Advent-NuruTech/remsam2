# Firebase client (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
# Production: route this domain to the Next.js deployment and configure Google OAuth.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=auth.remsamhomestead.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (use JSON or all three split variables)
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin onboarding
SIGN_UP_CODE=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Cloudflare D1
CF_ACCOUNT_ID=
CF_API_TOKEN=
D1_DATABASE_ID=

# YouTube Data API key (server only); channel links are managed in the admin panel.
YOUTUBE_API_KEY=

# Legacy channel IDs and keys (optional fallback)
NEXT_PUBLIC_YOUTUBE_API_KEY=
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=
NEXT_PUBLIC_YOUTUBE_API_KEY_2=
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID_2=

# Public site origin used for article sharing previews
NEXT_PUBLIC_SITE_URL=https://remsamhomestead.com

# Remsam Homestead email delivery and scheduled campaigns
RESEND_API_KEY=
RESEND_FROM_EMAIL=Remsam Homestead <newsletter@remsamhomestead.com>
NEWSLETTER_UNSUBSCRIBE_SECRET=
CRON_SECRET=
CRONJOB_ORG_API_KEY=

# Paystack checkout (server-only secret; configure the webhook in Paystack as
# https://your-domain/api/payments/paystack/webhook)
PAYSTACK_SECRET_KEY=
# Optional explicit callback URL. If omitted, NEXT_PUBLIC_SITE_URL/payment/verify is used.
PAYSTACK_CALLBACK_URL=

# USD donations receive a live KES conversion quote from the public ER-API
# endpoint. No exchange-rate API key is needed; the checkout fails safely if a
# current quote cannot be obtained.
